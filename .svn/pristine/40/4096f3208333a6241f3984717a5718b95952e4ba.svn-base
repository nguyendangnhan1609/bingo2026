import { NgModule } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { BrowserModule } from '@angular/platform-browser';
import { Routes, RouterModule } from '@angular/router';
import { ClientGameComponent } from './client-game/client-game.component';
import { MaterGameComponent } from './master-game/master-game.component';
export const routes: Routes = [
    { path: 'materGame', component: MaterGameComponent },
    { path: 'clientGame', component: ClientGameComponent },
    { path: '', redirectTo: '/materGame', pathMatch: 'full' },
    { path: '**', redirectTo: '/materGame' },
]

@NgModule({
    imports: [
        BrowserModule,
        FormsModule,
        RouterModule.forRoot(routes, { useHash: true })],
    exports: [RouterModule]
})
export class AppRoutingModule { }
