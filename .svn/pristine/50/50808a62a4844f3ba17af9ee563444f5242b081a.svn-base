<div id="modal-client" class="modal-custom" (click)="closeModal()">
	<div class="modal-content">
		<h1>XIN CHÚC MỪNG!</h1>
		<img class="modal-img" src="../../assets/images/bingo-gif8.gif" alt="cookies-img" />
	</div>
</div>
<div class="row bingo-main">
	<div class="col-lg-3 col-md-12 col-sm-12 my-3">
		<div class="card">
			<div class="card-body">
				<!-- <div class="col-lg-12 col-md-12 col-sm-12">
					<label class="px-0">Mã nhân viên</label>
					<select class="form-control staffId-slt" [formControl]="staffId" (change)="changedStaffId()">
						<option value="-1">Chọn mã nhân viên...</option>
						<ng-container *ngFor="let staff of staffIdList">
							<option [value]="staff.id">
								{{ staff.id }}
							</option>
						</ng-container>
					</select>
				</div> -->
				<div class="col-lg-12 col-md-12 col-sm-12">
					<label class="px-0">Tìm kiếm</label>
					<div class="input-group">
						<input type="text" (keydown.enter)="$event.preventDefault()" placeholder="Nhập tên người chơi..."
						class="form-control form-search" aria-label="Number" matInput [formControl]="myControl"
						[matAutocomplete]="auto">
					<mat-autocomplete autoActiveFirstOption #auto="matAutocomplete" [displayWith]="displayFirmwares">
						<mat-option *ngFor="let option of filteredOptions | async" [value]="option"
							(onSelectionChange)="getIdFromFirmware($event, option)">
							{{option.name}}
						</mat-option>
					</mat-autocomplete>
						<div class="input-group-prepend">
							<span class="input-group-text pointer btn-clear" (click)="clearSearch()">
								<i class="material-icons">backspace</i>
							</span>
						</div>
					</div>
					
				</div>
				<div class="col-lg-12 col-md-12 col-sm-12">
					<label class="px-0">Tên người chơi</label>
					<select class="form-control staffName-slt" [formControl]="staffName" (change)="changedStaffName()">
						<option value="-1">Chọn tên người chơi...</option>
						<ng-container *ngFor="let staff of staffNameList">
							<option [value]="staff.id">
								{{ staff.name }}
							</option>
						</ng-container>
					</select>
				</div>
				<div class="col-lg-12 error" *ngIf="txtError">{{ txtError }}</div>
				<div class="col-lg-12 col-md-12 col-sm-12">
					<label class="px-0">Tải ảnh</label>
					<div class="download-group">
						<div style="display: flex;">
							<button (click)="downloadImage()" class="btn spin form-control m-1">
								1
							</button>
							<button (click)="downloadImageMulti()" class="btn spin form-control m-1">
								20+
							</button>
						</div>
					</div>
				</div>
				<button (click)="btnClear()" class="btn spin form-control mt-3">Làm Mới</button>
			</div>
		</div>
	</div>
	<div *ngIf="boardArrayDisplay.length > 0" class="col-lg-5 col-md-12 col-sm-12" #screen>
		<div class="col-12 my-3 table-container">
			<table class="table">
				<!-- <span class="bg-text-staffid">{{ staffId.value }}</span> -->
				<tr>
					<th class="b-color" id="B">B</th>
					<th class="i-color" id="I">I</th>
					<th class="n-color" id="N">N</th>
					<th class="g-color" id="G">G</th>
					<th class="o-color" id="O">O</th>
				</tr>
				<tr *ngFor="let row of boardArrayDisplay; let x = index">
					<td *ngFor="let column of boardArrayDisplay[x]; let y = index"
						(click)="selected(x, y, boardArrayDisplay[y][x])"
						[class.field-disabled]="boardArrayDisplay[x][y] === boardArrayDisplay[2][2]">
						<div class="td-content" id="{{x + '-' + y + '-' + boardArrayDisplay[y][x] }}">
							<ng-container
								*ngIf="boardArrayDisplay[x][y] === boardArrayDisplay[2][2]; then free; else number">
							</ng-container>
							<ng-template #number>
								{{ boardArrayDisplay[y][x] < 10 ? '0' + boardArrayDisplay[y][x] :
									boardArrayDisplay[y][x]}} </ng-template>
									<ng-template #free>
										<img alt="Brycen Logo" class="img-fluid"
											src="data:image/png;base64,">
									</ng-template>
						</div>
					</td>
				</tr>
			</table>
			<!-- <span class="txt-table-id">{{ staffId.value }}</span> -->
			<span class="txt-table-name">{{ txtstaffName }}</span>
		</div>
	</div>
	<div id="download" style="display: none;">
		<img #canvas>
		<a #downloadLink></a>
	</div>
</div>