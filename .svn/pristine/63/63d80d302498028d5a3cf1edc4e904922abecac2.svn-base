import { AfterViewInit, Component, OnInit } from '@angular/core';
import { FormControl } from '@angular/forms';
import { Router } from '@angular/router';

@Component({
  selector: 'app-root',
  templateUrl: './app.component.html',
  styleUrls: ['./app.component.css']
})
export class AppComponent implements AfterViewInit, OnInit {
  public textTilte: string = "YEAR END PARTY 2022";
  public formTitle: FormControl = new FormControl("YEAR END PARTY 2022");
  constructor(private router: Router) {
  }

  ngOnInit(): void {
  }

  ngAfterViewInit() {
  }

  scroll() {
    window.scrollTo({
      top: 1000,
      behavior: 'smooth'
    });
  }

  manual() {
    window.open('https://docs.google.com/presentation/d/1CTcwuLsqqiMKWXh_yN1i2uAn3l1OUXp92fvAusJZptg/edit?usp=sharing');
  }

  openModalTitle() {
    const el = document.querySelector('#modal-title');
    el.classList.add('show-modal');
    this.formTitle.setValue(this.textTilte);
  }

  closeModalTitle() {
    const el = document.querySelector('#modal-title');
    el.classList.remove('show-modal');
    this.formTitle.setValue("YEAR END PARTY 2022");
  }

  confirmModalTitle() {
    this.textTilte = this.formTitle.value;
    const el = document.querySelector('#modal-title');
    el.classList.remove('show-modal');
  }

}
