.curent-number-mobile-b {
  color: #ee7752;
  font-weight: 700;
  font-size: 20px;
}

.curent-number-mobile-i {
  color: #e73c7e;
  font-weight: 700;
  font-size: 20px;
}

.curent-number-mobile-n {
  color: #23a6d5;
  font-weight: 700;
