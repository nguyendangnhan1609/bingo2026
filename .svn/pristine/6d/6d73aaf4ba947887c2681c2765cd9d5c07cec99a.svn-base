/* HTML: <div class="loader"></div> */
.loader {
  width: 85%;
  --b: 10px;
  aspect-ratio: 1;
  border-radius: 50%;
  padding: 1px;
  background: conic-gradient(#0000 10%, #f03355) content-box;
  -webkit-mask: repeating-conic-gradient(#0000 0deg, #000 1deg 20deg, #0000 21deg 36deg),
    radial-gradient(farthest-side, #0000 calc(100% - var(--b) - 1px), #000 calc(100% - var(--b)));
  -webkit-mask-composite: destination-in;
  mask-composite: intersect;
}

.run-loader {
  animation: l4 1s infinite steps(10);
}

@keyframes l4 {
  to {
    transform: rotate(1turn)
  }
}

#canh-dao {
  width: 27%;
  position: absolute;
  right: 0;
  top: 0;
}

.img-den-long {    
  width: 23%;
  position: absolute;
  top: -7px;
  left: 10px;
}

.countDown {
  background-color: yellow;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0px 0px 5px 0px;
}

.flipdown {
  width: unset !important;
}

.flipdown .rotor-group:first-child {
  display: none;
}

/* countDown new */
#count-progress>svg {
  height: 100%;
}

#count-progress>svg>circle {
  fill: none;
  stroke-opacity: 0.3;
  stroke: #4892ff;
  stroke-width: 10;
  transform-origin: center center;
  transform: rotate(-90deg);
}

#count-progress-mobile>svg>circle {
  fill: none;
  stroke-opacity: 0.3;
  stroke: #4892ff;
  stroke-width: 5;
  transform-origin: center center;
  transform: rotate(-90deg);
}

#count-progress>svg>circle+circle {
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  stroke-linecap: round;
  stroke-opacity: 1;
  stroke: url(#RadialGradient1);
}

#count-progress-mobile>svg>circle+circle {
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  stroke-linecap: round;
  stroke-opacity: 1;
  stroke: url(#RadialGradient2);
}

#count-progress.animatable>svg>circle+circle,
#count-progress-mobile.animatable>svg>circle+circle {
  transition: stroke-dashoffset 0.5s ease;
}

#count-progress>svg>text {
  font-size: 50px;
}

#count-progress-mobile>svg>text {
  font-size: 30px;
}

.numberRandom {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}

/* ----------responsive---------- */
/* for mobile */
@media only screen and (max-width:960px) {
  body {
    /* background: url("./image/bg-tet.png") no-repeat center center fixed; */
    background-image: linear-gradient(135deg, #f00 0%, #f00 50%, #0f0 50%, #0f0 100%);
    background-color: #b42424;
    background-position: center;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    background-size: cover;
  }
  .text-complete-top{
    display: block;
  }
  #text-complete-bottom{
    display: none;
  }
  .text-brycen {
    color: #fff;
    text-shadow:
      0 0 10px #fff,
      0 0 21px #fff,
      0 0 42px #609926,
      0 0 82px #609926,
      0 0 92px #609926,
      0 0 102px #609926,
      0 0 151px #609926;
  }

  .countdownt {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 17% !important;
    height: 65px !important;
    padding: 1px !important;
    margin-right: 5px !important;
    background-color: #fff !important;
    border-radius: 10px !important;
    box-shadow: none !important;
  }

  .box-number-mobile {
    width: calc(100% - 75px);
  }

  .box-number-mobile-right {
    width: calc(100% - 60px);
    padding-left: 10px;
  }

  #count-progress-mobile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    padding: 1px !important;
    margin-right: 5px !important;
    background-color: #fff !important;
    border-radius: 10px !important;
    box-shadow: none !important;
  }

  #count-progress-mobile #number {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #fff;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    z-index: 1;

    position: absolute;
    font-size: 28px !important;
    color: #b47172;
  }
  #text-complete-bottom{
    position: absolute;
    z-index: 1000; /* Đảm bảo nó nằm trên cùng */
    top: 0; /* Đặt vị trí từ trên xuống */
    left: 0; /* Đặt vị trí từ trái sang */
    width: 200px;
    height: 30px;
    background-color: blue;
  }

  #container-message .card-body {
    width: 310px;
  }

  .width-75 {
    width: 100% !important;
  }

  .form-control,
  .dropdown-content,
  .text-complete, 
  .btn,
  .notification-marquee {
    font-size: 13px !important;
    color: yellow;
  }

  
  #footer{
    font-size: 13px !important;
    /* color: yellow; */
  }

  .card-body {
    min-height: unset !important;
  }

  #container-content {
    min-height: unset !important;
  }

  /* body {
    -webkit-background-size: cover;
    -moz-background-size: cover;
    -o-background-size: cover;
    background-size: cover;
  } */

  .dropdown {
    display: flex;
  }

  #container-number {
    display: none !important;
  }

  #container-bingo {
    padding: 0 15px 0 15px !important;
  }

  #container-message {
    display: none !important;
  }

  #chat-icon {
    z-index: 100;
    /* Đặt mức ưu tiên cao */
    background-color: none;
    /* Đảm bảo nền không trong suốt */
  }
  /* #chat-container {
    display: block !important;
  } */

  .card {
    border: none !important;
  }

  .card-body {
    padding: 0 !important;
  }

  .table {
    width: 100% !important;
  }

  th,
  td {
    font-size: 10vw;
  }

  #container-number-mobile {
    display: flex;
  }

  #container-status {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
  }

  .title {
    font-size: 30px;
  }

  /* 100% Image Width on Smaller Screens */
  .modal-content {
    width: 100%;
  }

  /* Responsive layout - makes the three columns stack on top of each other instead of next to each other */
  .row {
    -webkit-flex-direction: column;
    flex-direction: column;
  }

  .header {
    -webkit-flex-direction: column;
    flex-direction: column;
  }

  .user-input {
    display: block;
    min-width: 100%;
  }

  #user-select {
    display: block;
    min-width: 100%;
  }

  .pass-input {
    display: block;
    flex-grow: 1;
  }

  .header-user {
    text-align: right;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    min-width: 200px;
  }

  .block-search {
    text-align: center;
  }

  .block-select {
    text-align: center;
  }

  .block-pass {
    text-align: center;
    flex-direction: column;
  }

  .dropdown-content {
    top: 33px;
    width: 92%;
  }

  .modal-custom,
  .show-modal {
    transition: none !important;
  }

  .img-den-long {
    width: 20% !important;
    position: absolute;
    top: -12px;
    left: 10px;
  }

  .modal-custom-count-down {
    top: 70%;
  }
}

@media (min-width:641px) and (max-width:960px) {

  /* portrait tablets, portrait iPad, landscape e-readers, landscape 800x480 or 854x480 phones */
  .table {
    width: 85% !important;
  }

  th,
  td {
    font-size: 9vw;
  }

  .form-control,
  .dropdown-content,
  .text-complete,
  #footer,
  .btn,
  .notification-marquee {
    font-size: 18px !important;
  }

  .title {
    font-size: 50px;
  }

  .box-number-mobile {
    height: 80px;
    width: calc(100% - 80px);
  }

  .box-number-mobile-right {
    width: calc(100% - 82px);
    justify-content: space-between;
  }

  .current-number-mobile span {
    font-size: 33px !important;
  }

  #count-progress-mobile {
    width: 80px !important;
    height: 80px !important;
    max-width: 80px !important;
    max-height: 80px !important;
  }

  .curent-number-mobile-b,
  .curent-number-mobile-i,
  .curent-number-mobile-n,
  .curent-number-mobile-g,
  .curent-number-mobile-o {
    font-size: 23px;
  }

  .count-number-mobile {
    text-align: end;
    font-size: 17px;
  }

  .current-number-mobile span {
    font-size: 40px !important;
  }

  .current-number-mobile {
    width: 70px;
    min-width: 70px;
  }

  .loader {
    width: 90%;
  }

  #count-progress-mobile #number {
    font-size: 35px !important;
  }

}

/* tablet, landscape iPad, lo-res laptops ands desktops */
@media (min-width:961px) and (max-width:1280px) {
  .title {
    font-size: 6vw;
  }

  #container-message {
    display: none;
  }

  #container-number {
    max-width: 43%;
  }

  #container-bingo {
    max-width: 57%;
  }

  #container-bingo .card {
    margin-right: 15px;
  }

  td,
  th {
    font-size: 5vw;
  }

  .current-number {
    width: 75%;
  }

  #count-progress {
    width: 24%;
  }

  .card {
    height: 100%;
  }

  .random-header {
    height: 110px;
  }

  #count-progress>svg>text {
    font-size: 35px;
    transform: translateY(0%);
  }

}

@media (min-width:992px) {
  #container-message {
    display: none;
  }

  #container-number {
    flex: 0 0 43%;
    max-width: 43%;
  }

  #container-bingo {
    flex: 0 0 57%;
    max-width: 57%;
  }

  .p-numbers {
    font-size: 7.5vw;
  }

  #count-progress>svg>circle {
    r: 33% !important;
  }

  #count-progress>svg>text {
    font-size: 40px;
    transform: translateY(0%);
  }

  .random-header {
    height: unset;
  }
}

@media (min-width:1281px) and (max-width:1500px) {
  #count-progress>svg>circle {
    r: 30% !important;
  }

  #count-progress>svg>text {
    font-size: 45px !important;
  }
}

@media (min-width:1281px) {

  /* hi-res laptops and desktops */
  #container-message {
    display: block;
  }

  #chat-icon {
    display: none !important;
  }

  /* .notifications .n {
    display: block !important;
  } */


  #chat-box {
    display: none !important;
  }

  .box-mess {
    font-size: 18px;
  }

  .box-mess-right {
    font-size: 18px;
  }

  #container-number,
  #container-bingo {
    /* col-lg-4 */
    flex: 0 0 33.333333%;
    max-width: 33.333333%;
  }

  #bingo-card table {
    width: 89% !important;
  }

  .p-numbers {
    font-size: 6vw;
  }

  .current-number {
    width: 76%;
  }

  #count-progress {
    width: 23%;
  }

  #count-progress>svg>circle {
    r: 35%;
  }

  #count-progress>svg>text {
    font-size: 50px;
    transform: translateY(1%);
  }
}

.notifications {
  position: fixed;
  bottom: 20px;
  right: 20px;
  text-align: right;
  z-index: 100;
  cursor: pointer;
}

.notifications .n {
  position: relative;
  margin-top: 15px;
  transition: transform 0.1s ease-in-out, opacity 0.1s ease-in-out;
  opacity: 0;
  transform: translateY(100%);
}

.notifications .n::before {
  content: attr(data-msg);
  display: inline-block;
  background-color: #fd6801;
  border-radius: 5px;
  font-family: Verdana;
  color: #fff;
  padding: 15px;
  box-shadow: -7px 8px 2px rgba(0, 0, 0, 0.2);
}

.notifications .n:after {
  left: 100%;
  top: 50%;
  border: solid transparent;
  content: "";
  height: 0;
  width: 0;
  position: absolute;
  pointer-events: none;
  border-color: rgba(253, 104, 1, 0);
  border-left-color: #fd6801;
  border-width: 10px;
  margin-top: -10px;
}

.notifications .n.in {
  opacity: 1;
  transform: translateY(0%);
}

.notifications .n.out {
  opacity: 0;
  transform: translateY(100%);
}

.px-gridbox {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(3, 1fr);
}

.px-griditem {
  font-size: 1rem;
  border: 2px solid rgb(27, 34, 55);
  border-radius: 6px;
  background-color: rgb(12, 16, 29);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: end;
  min-width: 110px;
}

.px-griditem .notification-text {
  width: 130px;
  height: 100%;
  padding: 10px;
  color: white;
  text-align: center;
}

.px-griditem .notification-icon {
  display: block;
  width: 100%;
  background: #fff;
  text-align: center;
  border-radius: 0 0 4px 4px;
}

.px-griditem.item-success {
  border-color: #23d5ab;
}

.px-griditem.item-success .notification-icon {
  background: #23d5ab;
}

.px-griditem.item-success .notification-text {
  color: #23d5ab;
}

.px-griditem.item-warning {
  border-color: #fc8621;
}

.px-griditem.item-warning .notification-icon {
  background: #fc8621;
}

.px-griditem.item-warning .notification-text {
  color: #fc8621;
}

.px-griditem.item-error {
  border-color: #e73c7e;
}

.px-griditem.item-error .notification-icon {
  background: #e73c7e;
}

.px-griditem.item-error .notification-text {
  color: #e73c7e;
}

.chat-icon {
  position: fixed;
  bottom: 70px;
  right: 5px;
  cursor: pointer;
}

/* Chatbox ở góc dưới và có thể hiện/ẩn */
.chat-container {
  position: fixed;
  bottom: 80px;
  /* Vị trí ngay trên icon */
  right: 20px;
  width: 300px;
  height: 364px;
  /* border: 1px solid #ccc; */
  background-color: white;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  display: none;
  /* Ẩn chatbox ban đầu */
  border-radius: 4%;
}

.chat-header {
  background-color: #FFFFFF;
  color: black;
  /* Màu chữ trắng */
  padding: 10px;
  /* Khoảng cách bên trong */
  display: flex;
  /* Sử dụng Flexbox */
  justify-content: center;
  /* Canh giữa theo chiều ngang */
  align-items: center;
  /* Canh giữa theo chiều dọc */
  position: relative;
  /* Để định vị nút đóng */
  font-size: 16px;
  /* Kích thước chữ */
  border-radius: 11px 11px 0% 0%;
  z-index: 10;
  /* Ưu tiên header hiển thị */
  font-family: system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
  font-weight: bold;
}

.chat-header .close-btn {
  position: absolute;
  /* Đặt nút đóng ở vị trí tuyệt đối */
  right: 10px;
  /* Căn phải cách lề phải 10px */
  background: none;
  /* Xóa nền */
  border: none;
  /* Xóa viền */
  color: #555;
  /* Màu chữ */
  font-size: 200%;
  /* Kích thước chữ */
  cursor: pointer;
  /* Thêm con trỏ chuột */
}

.chat-header .close-btn:hover {
  color: #ccc;
  /* Đổi màu khi di chuột qua nút đóng */
}

.close-btn:active {
  outline: none;
  /* Xóa outline khi nhấn */
  box-shadow: none;
  /* Xóa shadow khi nhấn */
}

.close-btn {
  border: none;
  background: none;
  outline: none;
  user-select: none !important;
  /* Ngăn chọn/kéo */
  pointer-events: auto;
  /* Bảo đảm nút vẫn có thể click */
}

.close-btn:active {
  background: none;
  border: none;
}

.emojiStyleBox {
  width: 40px !important;
  /* height: 30px; */
}

#tblEmojiListBox tr td {
  display: table-cell !important;
  width: 11%;
  position: relative;
  font-size: 33px;
  font-weight: bold;
  cursor: pointer;
  background-color: #feef86;
  text-align: center;
  border: none;
}

.emotionBox {
  display: none;
  position: absolute;
  bottom: 30px;
  width: 300px;
  height: 250px;
  background-color: #FEEF86;
  border-radius: 5px;

}

.btnIconBox {
  margin-top: 0% !important;
}

.btnEmojiBox,
.btnStickerBox {
  font-size: 23px !important;
  border: none;
}

td.btnEmojiBox:after {
  content: none;
  margin-top: 0%;
  /* Xóa margin top */
}

td.btnStickerBox:after {
  content: none;
  margin-top: 0%;
  /* Xóa margin top */
}

#tblEmojiListBox tr td:after {

  margin-top: 0% !important;
}

#tblStickerListBox tr td:after {

  margin-top: 0% !important;
}

#chat-box {
  /* background-image: url("./image/bg-tet-mobile.png"); */
  background-color: #b42424;
}

.mess-list-box {
  font-size: 12px;
  height: 282px;
}

.card-body-box ul li {
  margin-left: 18px;
}

#messageBox {
  max-height: 80px;
  /* Chiều cao tối đa của div */
  overflow-y: auto;
  /* Tạo cuộn dọc khi nội dung vượt quá chiều cao */
}

/* width */
#messageBox::-webkit-scrollbar {
  width: 10px;
}

/* Track */
#messageBox::-webkit-scrollbar-track {
  box-shadow: inset 0 0 5px #ffffff;
  border-radius: 10px;
  /* background-color: url(./image/bg-tet-mobile.png); */
  background-color: #b42424;
}

/* Handle */
#messageBox::-webkit-scrollbar-thumb {
  background: #757070;
  border-radius: 10px;
}

/* Handle on hover */
#messageBox::-webkit-scrollbar-thumb:hover {
  background: #ffffff;
  /* Sử dụng dấu nháy kép hoặc bỏ hẳn */
}

#send-mess-list-box li {
  margin-left: 15px !important;
}

/* style modal */
.modal-custom-count-down {
  max-height: 300px;
  position: fixed;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  max-width: 300px;
  width: 50%;
  height: 50%;
  padding: 20px;
  background-image: url(./image/bingo-gif8.gif);
  background-size: cover;
  /* Giảm kích thước nền để phù hợp với nội dung */
  background-position: center;
  border-radius: 10px;
}

.modal-content-countdown {
  margin-top: 10% !important;
  text-align: center;
}

#time-count-down {
  font-size: 70px;
  font-weight: bold;
  margin-bottom: 20px;
  color: #ff6600;
  animation: blink 1s infinite;
}


.countdown-number {
  font-size: 24px;
  margin-bottom: 10px;
  animation: pulse 2s infinite;
}

.snowflake {
  color: #fff;
  font-size: 1em;
  font-family: Arial, sans-serif;
  text-shadow: 0 0 5px #000;
}
 
.snowflake,.snowflake .inner{animation-iteration-count:infinite;animation-play-state:running}@keyframes snowflakes-fall{0%{transform:translateY(0)}100%{transform:translateY(110vh)}}@keyframes snowflakes-shake{0%,100%{transform:translateX(0)}50%{transform:translateX(80px)}}.snowflake{position:fixed;top:-10%;z-index:9999;-webkit-user-select:none;user-select:none;cursor:default;animation-name:snowflakes-shake;animation-duration:3s;animation-timing-function:ease-in-out}.snowflake .inner{animation-duration:10s;animation-name:snowflakes-fall;animation-timing-function:linear}.snowflake:nth-of-type(0){left:1%;animation-delay:0s}.snowflake:nth-of-type(0) .inner{animation-delay:0s}.snowflake:first-of-type{left:10%;animation-delay:1s}.snowflake:first-of-type .inner,.snowflake:nth-of-type(8) .inner{animation-delay:1s}.snowflake:nth-of-type(2){left:20%;animation-delay:.5s}.snowflake:nth-of-type(2) .inner,.snowflake:nth-of-type(6) .inner{animation-delay:6s}.snowflake:nth-of-type(3){left:30%;animation-delay:2s}.snowflake:nth-of-type(11) .inner,.snowflake:nth-of-type(3) .inner{animation-delay:4s}.snowflake:nth-of-type(4){left:40%;animation-delay:2s}.snowflake:nth-of-type(10) .inner,.snowflake:nth-of-type(4) .inner{animation-delay:2s}.snowflake:nth-of-type(5){left:50%;animation-delay:3s}.snowflake:nth-of-type(5) .inner{animation-delay:8s}.snowflake:nth-of-type(6){left:60%;animation-delay:2s}.snowflake:nth-of-type(7){left:70%;animation-delay:1s}.snowflake:nth-of-type(7) .inner{animation-delay:2.5s}.snowflake:nth-of-type(8){left:80%;animation-delay:0s}.snowflake:nth-of-type(9){left:90%;animation-delay:1.5s}.snowflake:nth-of-type(9) .inner{animation-delay:3s}.snowflake:nth-of-type(10){left:25%;animation-delay:0s}.snowflake:nth-of-type(11){left:65%;animation-delay:2.5s}
