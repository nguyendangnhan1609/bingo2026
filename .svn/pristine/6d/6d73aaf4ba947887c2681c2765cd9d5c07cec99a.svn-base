}

.emotion .bi {
  color: #6fc149;
}

.emotion td {
  border: none;
  font-size: 24px;
  background-color: inherit;
}

.emotion td::after {
  content: inherit;
  display: block;
  text-align: center;
  margin-top: 100%;
}

.emotion hr {
  color: #cbc4c8;
}

