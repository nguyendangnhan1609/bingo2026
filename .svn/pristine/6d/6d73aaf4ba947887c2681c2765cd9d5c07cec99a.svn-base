  background-color: #feef86;
  border: 2px solid #D0C73A;
  text-align: center;
}

td:after {
  content: '';
  display: block;
  text-align: center;
  margin-top: 100%;
}

td .td-content {
  display: flex;
  position: absolute;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  left: 0;
  top: 0;
  bottom: 0;
  right: 0;
  background-color: #feef86;
}

