}

/* width */
.card-body ::-webkit-scrollbar {
  width: 20px;
}

/* Track */
.card-body ::-webkit-scrollbar-track {
  box-shadow: inset 0 0 5px #ffffff;
  border-radius: 10px;
}

/* Handle */
.card-body ::-webkit-scrollbar-thumb {
  background: #ffffff;
  border-radius: 10px;
}

/* Handle on hover */
.card-body ::-webkit-scrollbar-thumb:hover {
  background: '#d2d2d2';
}

/* width */
.card-body-box ::-webkit-scrollbar {
  width: 10px;
}

/* Track */
.card-body-box ::-webkit-scrollbar-track {
  box-shadow: inset 0 0 5px #ffffff;
  border-radius: 10px;
}

/* Handle */
.card-body-box ::-webkit-scrollbar-thumb {
  background: #ffffff;
  border-radius: 10px;
}

/* Handle on hover */
.card-body-box ::-webkit-scrollbar-thumb:hover {
  background: '#d2d2d2';
}

.drop-li {
  cursor: pointer;
}

/* style table */
table {
  border-collapse: collapse;
  border: none;
  border-radius: 20px 20px 0 0;
}

/* style modal */
.modal-custom-stop-game,
.modal-custom {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transform: scale(1.1);
  transition: visibility 0s linear 0.25s, opacity 0.25s 0s, transform 0.25s;
  z-index: 9999;

}

.modal-img {
  width: 200px;
  z-index: 999;
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  width: fit-content !important;
  transform: translate(-50%, -50%);
  font-weight: bold;
  /* background-color: #feef86 !important; */
  border-radius: 20px !important;
  text-align: center;
  align-items: center;
  padding: 20px;
  box-shadow: 5px 5px 30px 7px rgba(0, 0, 0, 0.25), -5px -5px 30px 7px rgba(0, 0, 0, 0.22);
}

#modal-bingo .modal-content {
  min-width: 350px !important;
}

.show-modal {
  opacity: 1 !important;
  visibility: visible !important;
  transform: scale(1.0) !important;
  transition: visibility 0s linear 0s, opacity 0.25s 0s, transform 0.25s !important;
}

.box-mess-ad {
  border-radius: 0 10px 10px 10px;
  background-color: #ffff0026;
  width: fit-content;
  padding: 7px;
  overflow-wrap: anywhere;
  min-width: 60px !important;
  font-size: 18px;
}

.box-mess {
  border-radius: 0 10px 10px 10px;
  background-color: white;
  width: fit-content;
  padding: 7px;
  overflow-wrap: anywhere;
  min-width: 60px !important;
  font-size: 12px;
}

.box-mess img {
  width: 30px;
}

.img-mess {
  width: 350px;
  border-radius: 10px;
  cursor: pointer;
}

.box-mess-right {
  margin-left: auto;
  border-radius: 10px 0 10px 10px;
  background-color: #a7d378;
  width: fit-content;
  padding: 7px;
  overflow-wrap: anywhere;
  min-width: 40px !important;
  font-size: 12px;
}

.box-mess-right img {
  width: 30px;
}

.img-mess-right {
  display: flex;
  margin-left: auto;
  width: 350px;
  border-radius: 10px;
  cursor: pointer;
}

.img-center {
  display: block;
  margin-top: auto;
  margin-bottom: auto;
}

.field-disabled {
  cursor: default !important;
  pointer-events: none;
}


#container-header {
  /* background-image: url("./image/bg.jpg"); */
  /* min-height: 138px; */
}

.title {
  /* font-size: 6vh; */
  font-size: calc(3vw - 3px);
  text-transform: uppercase;
}

.text-brycen {
  color: #ff2929;
  text-shadow:
    0 0 10px #fff,
    0 0 21px #fff,
    0 0 42px #609926,
    0 0 82px #609926,
    0 0 92px #609926,
    0 0 102px #609926,
    0 0 151px #609926;
}

.text-bingo {
  color: #fff;
  text-shadow:
    0 0 10px #fff,
    0 0 21px #fff,
    0 0 42px #609926,
    0 0 82px #609926,
    0 0 92px #609926,
    0 0 102px #609926,
    0 0 151px #609926;
  animation: flicker 1.5s infinite alternate;
  color: #fff;
}

@keyframes flicker {

  0%,
  18%,
  22%,
  25%,
  53%,
  57%,
  100% {

    text-shadow:
      0 0 10px #fff,
      0 0 21px #fff,
      0 0 42px #609926,
      0 0 82px #609926,
      0 0 92px #609926,
      0 0 102px #609926,
      0 0 151px #609926;

  }

  20%,
  24%,
  55% {
    text-shadow: none;
  }
}

