/* You can add global styles to this file, and also import other style files */

/* @font-face {
  src: url("./font/MetaVariableDemo-Set.woff2") format("woff2");
  font-family: "Meta";
  font-style: normal;
  font-weight: normal;
} */

@font-face {
  src: url('./font/Mitr-Regular.ttf') format('truetype');
  font-family: "Mitr-Regular";
  font-style: normal;
  font-weight: normal;
}

* {
  font-family: "Mitr-Regular", cursive;
}

html {
  min-height: 100% !important;
  height: 100%;
}

li {
  list-style: none;
}

body {
  height: 100%;
  width: auto;
  box-sizing: border-box;
  touch-action: manipulation;
  /* background: url("./image/bg-tet.png") no-repeat center center fixed; */
  background-image: linear-gradient(135deg, #FFC080 0%, #FFC080 50%, #8B9467 50%, #8B9467 100%);
  background-position: center;

  -webkit-background-size: cover;
  -moz-background-size: cover;
  -o-background-size: cover;
  background-size: cover;
}

.content {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}

/*background*/
.color-gradient {
  background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
  background-size: 400% 400%;
  -webkit-animation: 15s infinite gradient;
  animation: 15s infinite gradient;
  margin: 0 !important;
  min-height: 77vh;
}

@-webkit-keyframes gradient {
  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }
}

.hidden {
  display: none !important;
}

.logout {
  align-items: end;
}

.block-select {
  padding: 2px;
}

/* Container for flexboxes */
.row {
  display: -webkit-flex;
  display: flex;
}

/* Create three equal columns that sits next to each other */
.column {
  display: flex;
  -webkit-flex: 1;
  -ms-flex: 1;
  flex: 1;
  padding: 10px;
  min-height: 520px;
  border: 1px burlywood solid;
  justify-content: center;
}

/*mess-list*/
.mess-list {
  text-align: left;
  font-size: 14px;
}

/* Style the footer */
#footer {  
  background-color: #ffffff;
  display: flex;
  flex-direction: row;
  justify-content: center;
  width: 100%;
}

.footer-text {
  text-align: left;
  font-size: 0.8em;
  display: flex;
  align-items: center;
}

/*bingo number ---------*/
.bingo-number,
.list-number {
  width: 180px;
  height: 80px;
  border: 1px solid red;
  margin: 5px;
  padding: 12px 0;
  font-size: 50px;
}

.bingo-info {
  display: -webkit-flex;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.list-container {
  display: -webkit-flex;
  display: flex;
}

.bingo-item {
  width: 60px;

  border: 1px floralwhite solid;
}

.bingo-title {
  display: block;
  min-width: 40px;
  background: 0 0/400% 400%;
  border: 1px floralwhite solid;
  font-size: 48px;
}

/*SEARCH---------*/
.list-autocomplete {
  padding: 0;
}

.list-autocomplete em {
  font-style: normal;
  background-color: #e1f2f9;
}

.hasNoResults {
  color: #aaa;
}

.hasNoResults,
.btn-extra {
  display: block;
  padding: 10px;
}

.hasNoResults {
  color: #aaa;
}

.btn-extra {
  width: 100%;
  border-top: .5px solid #d2d2d2;
}

#send-mess-list {
  padding: 0 !important;
  width: 100%;
  height: 550px;
  overflow-y: auto;
}
#send-mess-list-box {
  padding: 0 !important;
  width: 100%;
  height: 282px;
  overflow-y: auto;
}

#login-notification {
  color: #ffff00;
  font-size: 12px;
  height: 20px;
}

.img-fluid {
  max-width: 100%;
  height: auto;
}

.current-number {
  justify-content: center;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20px;
  box-shadow: 5px 5px 30px 7px rgba(0, 0, 0, 0.25), -5px -5px 30px 7px rgba(0, 0, 0, 0.22);
