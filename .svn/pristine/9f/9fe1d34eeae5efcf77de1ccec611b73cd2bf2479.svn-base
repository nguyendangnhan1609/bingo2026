  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
}
 
.dashboard .groupButton .pauseBtn:hover {
  background-color: #a15b04;
}

.soundBtn {
  margin-left: 15px;
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #13c99b;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
}
.soundBtn:hover {
  background-color: #0b8b6b;
}

.dashboard .groupButton .playBtn {
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #19ac32;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
}

.dashboard .groupButton .playBtn:hover {
