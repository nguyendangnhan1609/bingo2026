:root {
  --green-admin: #0f0;
}

.pb-1 {
  padding-bottom: 1.25rem !important;
}
.container-winner {
  display: flex;
  justify-content: space-between;
  align-items: center;
} 

@import url('../font/Roboto-font.css');
@import url('../font/RobotoMono-font.css');

@font-face {
  src: url("../font/MetaVariableDemo-Set.woff2") format("woff2");
  font-family: "Meta";
  font-style: normal;
  font-weight: normal;
}

@font-face {
  src: url('../font/Mitr-Regular.ttf') format('truetype');
  font-family: "Mitr-Regular";
  font-style: normal;
  font-weight: normal;
}

* {
    font-family: "Mitr-Regular", cursive;
}

@import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap');
*
{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Quicksand', sans-serif;
}
body 
{
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #000;
}
section 
{
  position: absolute;
  width: 100vw;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 2px;
  flex-wrap: wrap;
  overflow: hidden;
}
section::before 
{
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(#000,#0f0,#000);
  animation: animate 5s linear infinite;
}
/* @keyframes animate 
{
  0%
  {
    transform: translateY(-100%);
  }
  100%
  {
    transform: translateY(100%);
  }
} */
section span 
{
  position: relative;
  display: block;
  width: calc(6.25vw - 2px);
  height: calc(6.25vw - 2px);
  background: #181818;
  z-index: 2;
  transition: 1.5s;
}
/* section span:hover 
{
  background: #0f0;
  transition: 0s;
} */

.signin
{
  position: absolute;
  width: 400px;
  background: #222;  
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px;
  border-radius: 4px;
  box-shadow: 0 15px 35px rgba(0,0,0,9);
}
.signin .content 
{
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 40px;
}
.signin .content h2 
{
  font-size: 2em;
  color: var(--green-admin);
  text-transform: uppercase;
}
.signin .content .form 
{
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 25px;
}
.signin .content .form .inputBox
{
  position: relative;
  width: 100%;
}
.signin .content .form .inputBox input 
{
  position: relative;
  width: 100%;
  background: #333;
  border: none;
  outline: none;
  padding: 25px 10px 7.5px;
  border-radius: 4px;
  color: #fff;
  font-weight: 500;
  font-size: 1em;
}
.signin .content .form .inputBox i 
{
  position: absolute;
  left: 0;
  padding: 15px 10px;
  font-style: normal;
  color: #aaa;
  transition: 0.5s;
  pointer-events: none;
}
.signin .content .form .inputBox input:focus ~ i,
.signin .content .form .inputBox input:valid ~ i
{
  transform: translateY(-7.5px);
  font-size: 0.8em;
  color: #fff;
}

.signin .content .form .links 
{
  position: relative;
  width: 100%;
  display: flex;
  justify-content: space-between;
}
.signin .content .form .links a 
{
  color: #fff;
  text-decoration: none;
}
.signin .content .form .links a:nth-child(2)
{
  color: var(--green-admin);
  font-weight: 600;
}
.signin .content .form .inputBox input[type="submit"]
{
  padding: 10px;
  background: var(--green-admin);
  color: #000;
  font-weight: 600;
  font-size: 1.35em;
  letter-spacing: 0.05em;
  cursor: pointer;
}
input[type="submit"]:active
{
  opacity: 0.6;
}
@media (max-width: 900px)
{
  section span 
  {
    width: calc(10vw - 2px);
    height: calc(10vw - 2px);
  }
}
@media (max-width: 600px)
{
  section span 
  {
    width: calc(20vw - 2px);
    height: calc(20vw - 2px);
  }
}

/* input:-webkit-autofill,
input:-webkit-autofill:focus {
  transition: background-color 0s 600000s, color 0s 600000s;
} */

input {
  color-scheme: dark;
}
/* ------------------------------------ */
.login-notification {
  color: red;
}

.hidden {
  display: none !important;
}

/* custom dashboard page */

.dashboard {
  width: 90%;
  height: 85%;
  position: absolute;
  background: #222;  
  z-index: 1000;
  padding: 40px;
  border-radius: 4px;
  box-shadow: 0 15px 35px rgba(0,0,0,9);
  color: #fff;
  overflow-y: overlay;
}

.dashboard .actions {
  width: 55%;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
}

.dashboard .content {
  width: 100%;
  /* height: 600px; */
  display: flex;
}


.dashboard .inputBox
{
  position: relative;
  /* width: 100%; */
}
.dashboard .inputBox input 
{
  position: relative;
  background: #333;
  border: none;
  outline: none;
  padding: 10px;
  border-radius: 4px;
  color: #fff;
  font-weight: 500;
  font-size: 1em;
}

.dashboard .inputBox input:focus ~ i,
.dashboard .inputBox input:valid ~ i
{
  transform: translateY(-7.5px);
  font-size: 0.8em;
  color: #fff;
}

.dashboard .inputBox input:disabled {
  background-color: #737373;
  color: black;
}

.dashboard .row {
  display: flex;
  padding: 10px 0;
}

.dashboard .row .label {
  display: flex;
  flex-wrap: wrap;
  align-content: center;
  width: 40%;
}

.dashboard .totalWinner, .dashboard .autoRestartTime {
  width: 123px;
}

.dashboard .headerDashborad {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
}
.dashboard .headerDashborad .information {
  display: flex;
  font-size: 1rem;
  align-items: center;
}

.dashboard .headerDashborad .information .logoutBtn {
  padding: 10px;
  margin-left: 15px;
  color: #fff;
  background-color: #009400;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
}

.dashboard .headerDashborad .information .logoutBtn:hover {
  background-color: #005a00;
}

.dashboard .titleDashboard {
  color: var(--green-admin);
  font-size: 2rem;
}

.dashboard .inputBox span {
  display: contents;
}

/* custom radio button */
.container{
  display: inline-block;
  position:relative;
  cursor:pointer;
  user-select: none;
  padding-left:25px;
  font-size: 17px;
  margin-right: 15px;
}

.container .checkmark:after{
  top:50%;
  left:50%;
  width: 9px;
  height: 9px;
  border-radius:50%;
  border: solid 2px white;
  transform:translate(-50%,-50%) rotate(45deg);
}

.container input:checked ~ .checkmark{
  background: #009400;
}
.container input:checked ~ .checkmark:after{
  display:block;
}

.container input {
  position: absolute;
  opacity: 0;
  cursor: pointer;
}

.checkmark{
  position:absolute;
  top:0;
  left:0;
  width:18px;
  height:18px;
  background:#eee;
  border-radius:50%;
  transition: all 0.1s linear 0s;
}

.checkmark:after{
  content:"";
  position:absolute;
  display:none;
}

.textNotification {
  /* position: relative; */
  background: #333;
  border: none;
  outline: none;
  padding: 10px;
  border-radius: 4px;
  color: #fff;
  font-weight: 500;
  font-size: 1em;
}

/* custom scrollbar */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-thumb {
  border-radius: 5px;
  background-color: var(--green-admin);
}

::-webkit-scrollbar-thumb:hover {
  background: #009400;
}

/* group button */
.dashboard .groupButton {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.reloadDataBtn {
  margin-right: 15px;
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #009400;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
}
.dashboard .groupButton .resetBtn {
  margin-right: 15px;
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #dc3545;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
  /* box-shadow: 0 15px 35px rgba(0,0,0,9); */
}

.dashboard .groupButton .resetBtn:hover {
  background-color: #8b1d28;
}

.dashboard .groupButton .sendNotificationBtn {
  margin-right: 15px;
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #007bff;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
}

.dashboard .groupButton .sendNotificationBtn:hover {
  background-color: #0057b4;
}

.winnerHistory {
  width: 45%;
  padding-left: 20px;
}

.winnerHistory .action {
  float: right;
}

.winnerHistory .action .clearBtn {
  margin-top: 2px;
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #dc3545;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
}
  
.winnerHistory .action .clearBtn:hover {
  background-color: #8b1d28;
}

.winnerHistory .winnerList {
  overflow-y: overlay;
  height: 450px;
}

.winnerHistory .winnerList p {
  padding: 5px 0;
}

hr {
  border: 2px solid #009400;
  margin: 10px 0px;
}

.winnerHistory .dataName {
  display: contents !important;
  color: #0f0;
}

.dashboard .winnerHistory .resetBtn {
  margin-right: 15px;
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #dc3545;
  border-radius: 7px;
  border: none;
  transition: all 0.2s linear 0s;
  cursor: pointer;
  /* box-shadow: 0 15px 35px rgba(0,0,0,9); */
}

.dashboard .winnerHistory .resetBtn:hover {
  background-color: #8b1d28;
}

/* modal */
.modal-custom {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transform: scale(1.1);
  transition: visibility 0s linear 0.25s, opacity 0.25s 0s, transform 0.25s;
  z-index: 9999;

}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  width: fit-content !important;
  transform: translate(-50%, -50%);
  font-weight: bold;
  background-color: #feef86 !important;
  border-radius: 20px !important;
  text-align: center;
  align-items: center;
  padding: 20px;
  box-shadow: 5px 5px 30px 7px rgba(0, 0, 0, 0.25), -5px -5px 30px 7px rgba(0, 0, 0, 0.22);
}

.modal-content {
  min-width: 350px !important;
}

.show-modal {
  opacity: 1 !important;
  visibility: visible !important;
  transform: scale(1.0) !important;
  transition: visibility 0s linear 0s, opacity 0.25s 0s, transform 0.25s !important;
}

.modal-content-loader {
  display: flex;
  justify-content: center;
  position: absolute;
  top: 50%;
  left: 50%;
  min-width: 200px;
  min-height: 200px;
  width: fit-content !important;
  transform: translate(-50%, -50%);
  font-weight: bold;
  background-color: #222 !important;
  border-radius: 20px !important;
  text-align: center;
  align-items: center;
  padding: 20px;
  box-shadow: 5px 5px 30px 7px rgba(0, 0, 0, 0.25), -5px -5px 30px 7px rgba(0, 0, 0, 0.22);
}

.loader {
  position: relative;
  width: 50px;
  height: 120px;
  z-index: 1000;
}

.loader span {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform: rotate(calc(18deg * var(--i)));
}

.loader span::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: #00ff0a;
  box-shadow: 0 0 10px #00ff0a, 
              0 0 50px #00ff0a;
  animation: animate34 1s linear infinite;
  animation-delay: calc(0.1s * var(--i));
}

@keyframes animate34 {
  0% {
    transform: scale(1);
  }

  80%,
  100% {
    transform: scale(0);
  }
}

.errorInput {
  color: red;
  font-size: 13px;
}

.dashboard .groupButton .pauseBtn {
  padding: 10px;
  font-size: 1rem;
  color: #fff;
  background-color: #c97613;
