.bingo-main {
	margin: 0;
	justify-content: center;
}

select {
	border-radius: 8px;
}

.table-container {
	justify-content: center;
	border-radius: 20px;
	background-color: #feef86;
	padding-top: 15px;
	padding-bottom: 27px;
	transition: 0.4s;
	/* box-shadow: 5px 5px 30px 7px rgba(0, 0, 0, 0.25), -5px -5px 30px 7px rgba(0, 0, 0, 0.22); */
}

.table {
	width: 100%;
	margin: 0;
	background-color: #feef86;
}

th {
	border-radius: 20px;
	display: table-cell !important;
	width: 20%;
	position: relative;
	font-weight: bold;
	text-align: center;
}

tr {
	background-color: #feef86;
}

td {
	display: table-cell !important;
	width: 20%;
	position: relative;
	font-size: 4.8vw;
	font-weight: bold;
	cursor: pointer;
	background-color: #feef86;
	border: 2px solid #D0C73A;
	text-align: center;
}

td:after {
	content: '';
	display: block;
	text-align: center;
	margin-top: 100%;
}

td .td-content {
	display: flex;
	position: absolute;
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
	left: 0;
	top: 0;
	bottom: 0;
	right: 0;
	background-color: #feef86;
}

button {
	display: flex;
	justify-content: center;
	align-items: center;
	background-color: transparent;
	border: none;
	outline: none;
	padding: 0;
	appearance: none;
}

button.spin {
	font-size: 16px;
	font-weight: 500;
	line-height: 1;
	padding: 8px 12px;
	border-radius: 8px;
	background-color: #7bbe35;
	color: white;
	text-shadow: rgba(0, 0, 0, 0.25) 0 3px 8px;
	text-align: center;
	transition: all .5s;
	user-select: none;
	-webkit-user-select: none;
	touch-action: manipulation;
	min-width: 55px;
}

button.spin:hover:not(:disabled) {
	opacity: 0.8;
	box-shadow: rgba(80, 63, 205, 0.5) 0 1px 30px;
	transition-duration: .1s;
}

.info-container {
	display: flex;
}

.bg-brycen {
	background-color: #7bbe35;
}

.text-result {
	font-size: 48px;
	color: black;
}

.responsive {
	width: 100%;
	height: auto;
}

.b-color {
	background: #ee7752;
	background-size: 400% 400%;
	animation: gradient 15s ease infinite;
	height: auto !important;
	border-radius: 15px;
	border: none !important;
	font-size: 48px;
}

.i-color {
	background: #e73c7e;
	background-size: 400% 400%;
	animation: gradient 15s ease infinite;
	height: auto !important;
	border-radius: 15px;
	border: none !important;
	font-size: 48px;
}

.n-color {
	background: #23a6d5;
	background-size: 400% 400%;
	animation: gradient 15s ease infinite;
	height: auto !important;
	border-radius: 15px;
	border: none !important;
	font-size: 48px;
}

.g-color {
	background: #23d5ab;
	/* background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab); */
	background-size: 400% 400%;
	animation: gradient 15s ease infinite;
	height: auto !important;
	border-radius: 15px;
	border: none !important;
	font-size: 48px;
}

.o-color {
	background: #ca87fe;
	background-size: 400% 400%;
	animation: gradient 15s ease infinite;
	height: auto !important;
	border-radius: 20px;
	border: none !important;
	font-size: 48px;
}

.form-search {
	border-radius: 8px;
}

.btn-clear {
	border-radius: 0 8px 8px 0 !important;
}

.pointer {
	cursor: pointer;
}

.qr-image {
	width: 270px;
}

.title-num {
	color: red;
}

.note {
	color: red;
}

.download-group {
	display: inline-block;
	margin-left: 10px;
	margin-top: 8px;
}

/* .bg-text-staffid {
	position: absolute;
	width: 100%;
	top: 50%;
	text-align: center;
	color: red;
	font-size: 6vw;
	opacity: 0.12;
	z-index: 2;
	font-style: italic;
	transform: rotate(45deg);
} */

.txt-table-id {
	position: absolute;
	bottom: 0;
	left: 0;
	margin-left: 15px;
	font-size: 15px;
	opacity: 0.4;
}

.txt-table-name {
	position: absolute;
	bottom: 0;
	right: 0;
	margin-right: 15px;
	font-size: 15px;
	opacity: 0.4;
}

.error {
	font-size: 16px;
	color: red;
}

/* Use a media query to add a break point at 800px: */
@media screen and (max-width: 960px) {
	.info-container {
		display: block;
	}

	.staffId-slt,
	.staffName-slt {
		width: 100%;
	}

	td {
		font-size: 8vw;
	}

	.bg-text-staffid {
		font-size: 13vw;
	}
}

@media screen and (max-width: 800px) {
	.info-container {
		display: block;
	}

	td {
		font-size: 8vw;
	}

	.bg-text-staffid {
		font-size: 13vw;
	}
}