import { Component, HostListener, OnInit } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable } from 'rxjs';
import { FormControl } from '@angular/forms';
import { Router } from '@angular/router';

@Component({
  selector: 'app-master-game',
  templateUrl: './master-game.component.html',
  styleUrls: ['./master-game.component.css']
})

export class MaterGameComponent implements OnInit {
  public randomNum: number = 0;
  public countTurns: number = 0;
  public randomNumDisplay: string = "00";
  public resultList: Array<number> = [];
  public resultListOrgin: Array<number> = [];
  public maxNumber: number[] = [];
  public tempNums: Array<number> = [];
  public started: boolean = false;
  public stoped: boolean = false;
  public maxRandom: boolean = false;
  public soundRulesFlag: boolean = true;
  public soundGiftFlag: boolean = true;
  public soundTrackFlag: boolean = false;
  public expandMoreFlag: boolean = true;
  public sortResultFlag: boolean = false;
  public startedAuto: boolean = false;
  public audio = new Audio();
  public isModeAuto: boolean = false;
  public dialingTimeout: number = 10000;
  public dialTime: number = 10000;
  public formDialingTimeout: FormControl = new FormControl(10);
  public formDialTime: FormControl = new FormControl(10);

  @HostListener('document:keyup', ['$event'])
  spaceEvent(event: any) {
    if (this.router.url === '/materGame' && event.keyCode == 32) {;
      if (this.startedAuto || this.maxRandom) {
        return;
      } else {
        if (!this.started) {
          this.btnStart();
        } else {
          this.btnStop();
        }
      }
    }
  }

  constructor(private http: HttpClient,
    private router: Router,) {
  }

  ngOnInit() {
    this.initValue();
    window.addEventListener('keydown', function(e) {
      if(window.location.hash == '#/materGame' && e.code === "Space") {
        e.preventDefault();
      }
    });
  }

  initValue() {
    this.audio.volume = 0;
    this.audio.pause();
    this.randomNum = 0;
    this.countTurns = 0;
    this.randomNumDisplay = "00";
    this.resultList = [];
    this.resultListOrgin = [];
    this.tempNums = [];
    this.maxNumber = [];
    this.startedAuto = false;
    this.started = false;
    this.stoped = false;
    this.maxRandom = false;
    this.soundRulesFlag = true;
    this.soundGiftFlag = true;
    this.soundTrackFlag = false;
    this.sortResultFlag = false;
    this.expandMoreFlag = true;
    this.isModeAuto = false;
    this.dialTime = 10000;
    this.dialingTimeout = 10000;
    this.formDialTime.setValue(10);
    this.formDialingTimeout.setValue(10);
    let maxNumber = 75;
    for (let i = 1; i <= maxNumber; i++) {
      this.maxNumber.push(i);
      this.tempNums.push(i);
    }
  }

  rouletto() {
    if (this.started) {
      this.randomNum = this.tempNums[Math.floor(Math.random() * this.tempNums.length)];
      if (this.randomNum <= 15) {
        let num = this.randomNum < 10 ? '0' + this.randomNum : this.randomNum;
        this.randomNumDisplay = "B-" + num;
      } else if (this.randomNum > 15 && this.randomNum <= 30) {
        this.randomNumDisplay = "I-" + this.randomNum;
      } else if (this.randomNum > 30 && this.randomNum <= 45) {
        this.randomNumDisplay = "N-" + this.randomNum;
      } else if (this.randomNum > 45 && this.randomNum <= 60) {
        this.randomNumDisplay = "G-" + this.randomNum;
      } else if (this.randomNum > 60 && this.randomNum <= 75) {
        this.randomNumDisplay = "O-" + this.randomNum;
      }
      setTimeout(() => this.rouletto(), 60);
    }

  }

  public getJSON(filename): Observable<any> {
    return this.http.get("./assets/" + filename);
  }

  btnCheckMode() {
    this.isModeAuto = !this.isModeAuto;
  }

  btnStart() {
    this.started = true;
    this.stoped = false;
    this.soundTrackFlag = true;
    if (this.isModeAuto) {
      this.startedAuto = true;
      this.autoStart();
    } else {
      setTimeout(() => { this.playAudio("soundTrack"); }, 150);
      this.rouletto();
    }
  }

  btnStop() {
    this.started = false;
    this.stoped = true;
    this.startedAuto = false;
    this.soundTrackFlag = false;
    this.stop();
  }

  autoStart() {
    if (this.countTurns > 34) {
      const el = document.querySelector('#modal-master');
      const cl = el.classList;
      cl.add('show-modal');
      this.startedAuto = false;
      this.started = false;
      this.isModeAuto = false;

      return;
    }
    setTimeout(() => { this.playAudio("soundTrack"); }, 150);
    this.rouletto();
    // if (!this.started || this.stoped) return;
    setTimeout(() => {
      if (!this.started || this.stoped || !this.isModeAuto) return;
      this.autoStop();
    }, this.dialTime);
  }

  stop() {
    this.pauseAudio("soundTrack");
    setTimeout(() => { this.playAudio(this.randomNum); }, 150);
    const index = this.tempNums.indexOf(this.randomNum);
    if (index > -1) { // only splice array when item is found
      this.tempNums.splice(index, 1); // 2nd parameter means remove one item only
    }
    if (this.tempNums.length < 1) {
      this.maxRandom = true;
    }
    this.resultList.push(this.randomNum);
    this.resultListOrgin.push(this.randomNum);
    this.countTurns++;
  }

  autoStop() {
    this.started = false;
    this.pauseAudio("soundTrack");
    setTimeout(() => { this.playAudio(this.randomNum); }, 150);
    const index = this.tempNums.indexOf(this.randomNum);
    if (index > -1) { // only splice array when item is found
      this.tempNums.splice(index, 1); // 2nd parameter means remove one item only
    }
    if (this.tempNums.length < 1) {
      this.maxRandom = true;
    }
    this.soundTrackFlag = false;
    this.resultList.push(this.randomNum);
    this.resultListOrgin.push(this.randomNum);
    this.countTurns++;
    // if (!this.startedAuto || this.stoped) return;
    setTimeout(() => {
      if (!this.startedAuto || this.stoped) return;
      this.started = true;
      this.soundTrackFlag = true;
      this.autoStart();
    }, this.dialingTimeout);
  }

  btnRestart() {
    this.initValue();
  }

  btnSave() {
    var url = "data:application/json;charset=UTF-8," + encodeURIComponent(JSON.stringify(this.resultList));
    var download = document.createElement('a');
    download.href = url;
    download.download = "Kết quả";
    download.click();
  }

  soundRules() {
    if (this.soundRulesFlag) {
      this.playAudio("soundRules");
    } else {
      this.pauseAudio("soundRules");
    }
    this.soundRulesFlag = !this.soundRulesFlag;
  }

  soundGift() {
    if (this.soundGiftFlag) {
      this.playAudio("soundGift");
    } else {
      this.pauseAudio("soundGift");
    }
    this.soundGiftFlag = !this.soundGiftFlag;
  }

  playAudio(filename) {
    this.audio.src = "../../../assets/audio/" + filename + ".mp3";
    this.audio.volume = 1;
    this.audio.load();
    setTimeout(() => { this.audio.play(); }, 150);

  }

  pauseAudio(filename) {
    this.audio.src = "../../../assets/audio/" + filename + ".mp3";
    this.audio.volume = 0;
    this.audio.pause();
  }

  getColorNum() {
    let color = "";
    if (this.randomNum <= 15) {
      color = "#ee7752";
    } else if (this.randomNum > 15 && this.randomNum <= 30) {
      color = "#e73c7e";
    } else if (this.randomNum > 30 && this.randomNum <= 45) {
      color = "#23a6d5";
    } else if (this.randomNum > 45 && this.randomNum <= 60) {
      color = "#23d5ab";
    } else if (this.randomNum > 60 && this.randomNum <= 75) {
      color = "#ca87fe";
    }
    return color;
  }

  openModalConfig() {
    const el = document.querySelector('#modal-config-time');
    el.classList.add('show-modal');
    this.formDialTime.setValue(this.dialTime / 1000);
    this.formDialingTimeout.setValue(this.dialingTimeout / 1000);
  }

  closeModalConfig() {
    const el = document.querySelector('#modal-config-time');
    el.classList.remove('show-modal');
    this.formDialTime.setValue(10);
    this.formDialingTimeout.setValue(10);
  }

  confirmModalConfig() {
    const el = document.querySelector('#modal-config-time');
    el.classList.remove('show-modal');
    this.dialTime = this.formDialTime.value * 1000;
    this.dialingTimeout = this.formDialingTimeout.value * 1000;
  }

  closeModal() {
    const el = document.querySelector('#modal-master');
    el.classList.remove('show-modal')
  }

  openModalImage() {
    const el = document.querySelector('#modal-link-qr');
    el.classList.add('show-modal');
  }

  closeModalImage() {
    const el = document.querySelector('#modal-link-qr');
    el.classList.remove('show-modal');
  }

  btnExpandMore() {
    this.expandMoreFlag = !this.expandMoreFlag;
  }

  btnSortResult() {
    this.sortResultFlag = !this.sortResultFlag;
    if (this.sortResultFlag) {
      this.resultList.sort((a, b) => a > b ? 1 : -1);
    } else {
      this.resultList = this.resultListOrgin.length > 0 ? [...this.resultListOrgin] : [];
    }
  }

}
