<!DOCTYPE html>
<html>

<head>
	<!-- <title> Brycen Bingo Christmas</title> -->
	<title> Brycen Bingo V3.0</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/x-icon" href="./image/favicon.ico">
	<link rel="stylesheet" href="style.css" />
	<link rel="stylesheet" href="./css/dropdown.css" />
	<link rel="stylesheet" href="./css/flipdown.css" />
	<link rel="stylesheet" href="./lib/bootstrap.min.css"
		integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
	<script src="./lib/jquery-3.1.1.min.js"></script>
</head>

<body>
	<div class="snowflakes" aria-hidden="true">
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
		<div class="snowflake">
		  <div class="inner">❅</div>
		</div>
	  </div>
	<!-- Modal Image -->
	<div id="moda-image" class="modal">
		<span class="close" onclick="closeModalImage()">&times;</span>
		<img src="" class="modal-content-img" id="image-content">
		<div id="caption"></div>
	</div>
	<!-- Modal Message -->
	<div id="modal-bingo" class="modal-custom" onclick="closeModal()">
		<div class="modal-content">
			<h3>Xin chúc mừng</h3>
			<h1 id="bingo-content"></h1>
			<img class="modal-img" src="image/bingo-gif8.gif" alt="cookies-img" />
		</div>
	</div>
	<div id="modal-stop-game" class="modal-custom" onclick="closeModalStopGame()">
		<div class="modal-content">
			<h4 class="m-0">Trò chơi đã kết thúc! <br> Vui lòng chờ vòng chơi sau nhé !</h4>
		</div>
	</div>
	<div id="modal-error" class="modal-custom" onclick="closeModalError()">
		<div class="modal-content">
			<h4>❌Số bạn chọn chưa có!</h4>
		</div>
	</div>
	<div id="modal-error-chat" class="modal-custom" onclick="closeModalErrorChat()">
		<div class="modal-content">
			<h4>❌Đăng nhập để sử dụng chat.</h4>
		</div>
	</div>
	<!-- <div id="modal-mess" class="modal-custom" onclick="closeModalMess()">
		<div class="modal-content">
			<h4 class="m-0">Đã làm mới Bingo!</h4>
		</div>
	</div> -->
	<div id="modal-time-count-down" class="modale-custom-count" >
		<div class="">
			<h4  id="time-count-down"></h4>
		</div>
	</div>	
	<div id="modal-pause" class="modal-custom">
		<div class="modal-content">
			<h4 class="m-0">Trò chơi đã tạm dừng!</h4>
		</div>
	</div>
	<div class="content">
		<!-- <img src="./image/logobrc.png" class="img-den-long"> -->
		<div class="content-child">
			<div id="container-header" class="row" style="margin: 0 !important;">
				<div class="col-lg-3 col-md-12 col-sm-12 img-center">
					<img hidden class="logo" src="./image/logobrc.png" style="width: 200px;">
					<div class="text-complete-top text-complete"></div>
				</div>
				<div class="col-lg-6 col-md-12 col-sm-12 center title-heder">
					<h1 class="title animate__animated animate__shakeX">
						<span class="text-brycen">Brycen Bingo</span>
					</h1>
					<div class="notification-marquee">
						<marquee class="marquee">&nbsp;</marquee>
					</div>
				</div>
				<div class="col-lg-3 col-md-12 m-0 p-0">
					<div class="col-12 my-2 hidden">
						<div class="input-group">
							<input type="text" class="form-control" name="userDropList" id="userDropList"
								placeholder="Nhập mã hoặc tên user...">
							<div class=" input-group-append">
								<button class="btn" type="submit">Tìm kiếm</button>
							</div>
						</div>
						<div class="suggestions">
							<ul style="max-height: 100px; overflow: auto;"></ul>
						</div>
					</div>
					<div class="col-12 dropdown my-2">
						<input class="form-control" onclick="fnShowValue()" type="text"
							placeholder="Nhập mã nhân viên hoặc họ tên có dấu" id="myInput" onkeyup="filterFunction()"
							autocomplete="off">
						<div id="myDropdown" class="dropdown-content" onfocusout="fnHiddenValue()" onf>
						</div>
						<button class="btn btn-danger hidden" id="btnLogout" onclick="logout()">Logout</button>
					</div>
					<div class="col-12 my-2">
						<div class="input-group" style="display: flex; justify-content: end;">
							<input type="password" class="form-control" onkeypress="pressLogin(event)" id="pass"
								placeholder="Nhập Password..." value="123456">
							<button class="btn btn-success button-login" id="btnLogin" onclick="login()">Login</button>
							<!-- <button class="btn btn-danger hidden" id="btnLogout" onclick="logout()">Logout</button> -->
						</div>
					</div>
					<div class="col-12 login-notification">
						<div id="login-notification"></div>
					</div>
				</div>
			</div>

			<!-- clock flip -->
			<div class="countDown hidden" id="countDown">
			</div>

			<div id="container-content" class="row" style="margin: 0 !important; min-height: 695px;">
				<!-- col 1 - Hiển thị bảng kết quả bingo -->
				<div id="container-number" class="col-lg-4 col-md-12 col-sm-12 pr-0">
					<div class="card">
						<div class="card-body">
							<div class="random-header">
								<div class="current-number">
									<div class="numberRandom">
										<p id="now-number" class="p-numbers"></p>
										<p id="count-number" class="count-number"></p>
									</div>
								</div>
								<div id="count-progress">
									<svg>
										<defs>
											<linearGradient id="RadialGradient1" x1="0%" y1="0%" x2="0%" y2="100%">
												<stop offset="0%" style="stop-color:#ffff00;stop-opacity:1" />
												<stop offset="100%" style="stop-color:#ff0000;stop-opacity:1" />
											</linearGradient>
										</defs>
										<circle cx="50%" cy="50%" r="35%" />
										<circle cx="50%" cy="50%" r="35%" pathLength="1" />
										<text x="50%" y="60%" text-anchor="middle">
											<tspan id="timeLeft">...</tspan>
										</text>
									</svg>
								</div>
							</div>
							<ul id="list-number"></ul>
						</div>
					</div>
				</div>
				<div id="container-number-mobile" class="col-lg-12 mt-2">
					<!-- <img src="./image/khung.png" alt="" class="img-khung"> -->
					<div id="count-progress-mobile">
						<svg>
							<defs>
								<linearGradient id="RadialGradient2" x1="0%" y1="0%" x2="0%" y2="100%">
									<stop offset="0%" style="stop-color:#ffff00;stop-opacity:1" />
									<stop offset="100%" style="stop-color:#ff0000;stop-opacity:1" />
								</linearGradient>
							</defs>
							<circle cx="50%" cy="50%" r="27" />
							<circle cx="50%" cy="50%" r="27" pathLength="1" />
							<text x="50%" y="57%" text-anchor="middle">
								<tspan id="timeLeftMobile">...</tspan>
							</text>
						</svg>
					</div>
					<div class="box-number-mobile">
						<div class="current-number-mobile" id="current-number-mobile">
						</div>
						<div class="box-number-mobile-right">
							<div id="list-number-mobile">
							</div>
							<span id="count-number-mobile" class="count-number-mobile"></span>
						</div>
					</div>

				</div>
				<!-- <div class="countDownTimer text-center">
				</div> -->
				<div id="container-bingo" class="col-lg-4 col-md-12 col-sm-12 px-0 ">
					<div class="card">
						<div class="card-body">
							<div id="bingo-card" class="col-lg-12 px-0 table-container field-disabled">
							</div>
						</div>
					</div>
					<!-- <img src="./image/canh-dao.png" alt="" id="canh-dao"> -->
				</div>
				<div id="container-message" class="col-lg-4 col-md-12 col-sm-12 pl-0">
					<div class="card">
						<div class="card-body">
							<div class="mess-list">
								<ul id="send-mess-list"></ul>
							</div>
							<form id="chat">
								<div class="emotion">
									<div class="emojiList tabcontent">
										<table id="tblEmojiList">
										</table>
									</div>
									<div class="stickerList tabcontent">
										<table id="tblStickerList">
											<tr>
												<td><img id="img-sticker1" onclick="sendSticker(this.id)"
														src="./image/stiker_loveBRC.png" alt="" width="130px"></td>
												<td><img id="img-sticker2" onclick="sendSticker(this.id)"
														src="./image/BRC_Sticker_02.png" alt="" width="130px"></td>
												<td><img id="img-sticker3" onclick="sendSticker(this.id)"
														src="./image/BRC_Sticker_03.png" alt="" width="130px"></td>
											</tr>
											<tr>
												<td><img id="img-sticker4" onclick="sendSticker(this.id)"
														src="./image/BRC_Sticker_04.png" alt="" width="130px"></td>
												<td><img id="img-sticker5" onclick="sendSticker(this.id)"
														src="./image/BRC_Sticker_05.png" alt="" width="130px"></td>
												<td><img id="img-sticker6" onclick="sendSticker(this.id)"
														src="./image/BRC_Sticker_06.png" alt="" width="130px"></td>
											</tr>
										</table>
									</div>
									<hr class="m-0">
									<div class="stickies">
										<table>
											<tr>
												<td class="btnEmoji">
													<span class="btnIcon" onclick="openTabEmotion('emojiList')"
														id="defaultOpen"><i class="bi bi-emoji-smile-fill"></i></span>
												</td>
												<td class="btnSticker">
													<span class="btnIcon" onclick="openTabEmotion('stickerList')"><i
															class="bi bi-stickies-fill"></i></span>
												</td>
											</tr>
										</table>
									</div>
								</div>
								<div class="input-group">
									<div class="input-group-prepend" onclick="toggleEmoji()">
										<span class="input-group-text btn" id="basic-addon1"><i id="icon-smile"
												class="bi bi-emoji-smile"></i></span>
									</div>
									<input id="messageFile" type="file" class="form-control hidden" placeholder="File"
										accept=".jpg,.jpeg,.png">
									<div id="message" contenteditable="true" class="form-control"
										data-text="Nhập tin nhắn < 300 ký tự" onkeyup="checkValueMessage()"
										onkeydown="enterSendMess(event)"></div>
									<div class="input-group-append">
										<button class="btn btn-success" onclick="clickSendMess()" type="submit"
											value="Send">Enter</button>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
				<div style="position: relative; height: 1px;">
					<div id="text-complete-bottom" class="text-complete"></div>				
				</div>
				<div class="col-lg-12 col-md-12 col-sm-12 my-2" style="display: flex; position: relative; justify-content: center;">					
					<div class="px-gridbox">
						<div class="px-griditem item-success">
							<div class="notification-text"><span id="total-online"></span></div>
							<span class="notification-icon bi bi-people-fill" style="color: white;"></span>
						</div>
						<div class="px-griditem item-warning">
							<span class="notification-text" id="dial-time"></span>
							<span class="notification-icon bi bi-stopwatch" style="color: white;"></span>
						</div>
						<div class="px-griditem item-error">
							<span class="notification-text" id="count-down"></span>
							<span class="notification-icon bi bi-hourglass-split" style="color: white;"></span>
						</div>
						<div id="chat-icon" class="chat-icon">
							<img src="./image/chat-icon2.png" alt="chat-icon" style="width: 50px; height: 50px;">
						</div>
						<div class="chat-container " id="chat-box"  >
							<div class="chat-header">
								<span>BINGO CHAT</span>
								<!-- <img src="image/BRC_Sticker_03.png" alt="chat-box" style="width: 20px; height: 25px;"> -->
								<div class="close-btn">-</div> 
							</div>
						<div class="chat-box ">
							<div class="mess-list-box card-body-box">
								<ul id="send-mess-list-box"></ul>
							</div>
							<form id="chat-content-box">
								<div class="emotionBox">
									<div class="emojiList tabcontent">
										<table id="tblEmojiListBox">
										</table>
									</div>
									<div class="stickerList tabcontent">
										<table id="tblStickerListBox">
											<tr>
												<td><img id="img-sticker1" onclick="sendStickerBox(this.id)"
														src="./image/stiker_loveBRC.png" alt="" width="130px"></td>
												<td><img id="img-sticker2" onclick="sendStickerBox(this.id)"
														src="./image/BRC_Sticker_02.png" alt="" width="130px"></td>
												<td><img id="img-sticker3" onclick="sendStickerBox(this.id)"
														src="./image/BRC_Sticker_03.png" alt="" width="130px"></td>
											</tr>
											<tr>
												<td><img id="img-sticker4" onclick="sendStickerBox(this.id)"
														src="./image/BRC_Sticker_04.png" alt="" width="130px"></td>
												<td><img id="img-sticker5" onclick="sendStickerBox(this.id)"
														src="./image/BRC_Sticker_05.png" alt="" width="130px"></td>
												<td><img id="img-sticker6" onclick="sendStickerBox(this.id)"
														src="./image/BRC_Sticker_06.png" alt="" width="130px"></td>
											</tr>
										</table>
									</div>
									<hr class="m-0">
									<div class="stickies">
										<table>
											<tr>
												<td class="btnEmojiBox">
													<span class="btnIconBox" onclick="openTabEmotion('emojiList')"
														id="defaultOpenBox"><i class="bi bi-emoji-smile-fill"></i></span>
												</td>
												<td class="btnStickerBox">
													<span class="btnIconBox" onclick="openTabEmotion('stickerList')"><i
															class="bi bi-stickies-fill"></i></span>
												</td>
											</tr>
										</table>
									</div>
								</div>
								<div class="input-group">
									<div class="input-group-prepend" onclick="toggleEmojiBox()">
										<span class="input-group-text btn" id="basic-addon1-box"><i id="icon-smile-box"
												class="bi bi-emoji-smile"></i></span>
									</div>
									<input id="messageFileBox" type="file" class="form-control hidden" placeholder="File"
										accept=".jpg,.jpeg,.png">
									<div id="messageBox" contenteditable="true" class="form-control"
										data-text="Tối đa 300 ký tự" onkeyup="checkValueMessageBox()"
										onkeydown="enterSendMessBox(event)" ></div>
									<div class="input-group-append">
										<button class="btn btn-success" onclick="clickSendMessBox()" type="submit"
											value="Send">Enter</button>
									</div>
								</div>
							</form>
						</div>		
						</div>	
					</div>
					<div class="notifications" id="notifications"></div>
				</div>
			</div>
		</div>
		<footer id="footer">
			<div><img alt="..." class="logo" src="./image/logobrc.png" style="width: 200px;"></div>
			<div class="footer-text">
				<span> ©2023 BRYCEN VietNam <br>
					PippiWeb Team<br>
					<a href="skype:mybrothervnn?chat">Report Bug via Skype</a>
				</span>
			</div>
			<div><img alt="..." class="logo" src="./image/game_link_qr.png" style="width: 70px;"></div>
		</footer>
	</div>
	<!-- Script -->
	<script src="/socket.io/socket.io.js"></script>
	<script src="client.js"></script>
	<script src="js/dropdown.js"></script>
	<script src="js/flipdown.js"></script>
	<!-- <script src='js/disable-devtool.js'></script>
	<script>
		DisableDevtool({
		})
	</script> -->
</body>

</html>